     fn name(&self) -> &'static str { "none" }
     fn uses_gpio_edges(&self) -> bool { false }
 }
+
+/// A bare module that records every GPIO output edge so a host (the browser page) can mirror the
+/// pins. Nothing is wired to the pins; console and everything else behave like `NoBoard`.
+#[derive(Default)]
+pub struct GpioProbeBoard {
+    log: std::sync::Mutex<Vec<(u8, bool)>>,
+}
+/// Upper bound on buffered edges between host drains; older edges are dropped past it.
+pub const GPIO_PROBE_MAX_EDGES: usize = 65_536;
+impl BoardModel for GpioProbeBoard {
+    fn name(&self) -> &'static str { "gpio-probe" }
+    fn gpio_changes(&mut self, changes: &[(u8, bool)]) {
+        let mut log = self.log.lock().unwrap_or_else(|e| e.into_inner());
+        for c in changes {
+            if log.len() >= GPIO_PROBE_MAX_EDGES { log.remove(0); }
+            log.push(*c);
+        }
+    }
+    fn take_gpio_log(&self) -> Vec<(u8, bool)> {
+        std::mem::take(&mut *self.log.lock().unwrap_or_else(|e| e.into_inner()))
+    }
+}
+
+#[cfg(test)]
+mod probe_tests {
+    use super::*;
+    #[test]
+    fn records_edges_in_order_and_drains() {
+        let mut b = GpioProbeBoard::default();
+        assert!(b.uses_gpio_edges());
+        b.gpio_changes(&[(2, true)]);
+        b.gpio_output_at(10, &[(2, false), (4, true)], 0, 0);
+        assert_eq!(b.take_gpio_log(), vec![(2, true), (2, false), (4, true)]);
+        assert!(b.take_gpio_log().is_empty());
+    }
+    #[test]
+    fn caps_buffered_edges() {
+        let mut b = GpioProbeBoard::default();
+        for i in 0..(GPIO_PROBE_MAX_EDGES + 5) { b.gpio_changes(&[(1, i % 2 == 0)]); }
+        assert_eq!(b.take_gpio_log().len(), GPIO_PROBE_MAX_EDGES);
+    }
+}
